PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Connection String (Atlas or Local)
# In production on Vercel, MONGODB_URI is required. In local dev, zero-config embedded storage is used if omitted.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/securepulse?retryWrites=true&w=majority

# JWT Secrets (Generate secure random 64-char strings for production)
JWT_ACCESS_SECRET=securepulse_super_secret_access_token_jwt_key_2026_xyz
JWT_REFRESH_SECRET=securepulse_super_secret_refresh_token_jwt_key_2026_abc

# ==============================================================================
# STANDARDIZED GMAIL SMTP CONFIGURATION (VERCEL PRODUCTION & LOCAL DEV)
# ==============================================================================
# Step 1: Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# Step 2: Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# Step 3: Enter your Gmail address and the 16-character App Password below (and in Vercel Environment Variables):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=xxxx yyyy zzzz wwww
EMAIL_FROM=your-gmail-address@gmail.com
SMTP_SECURE=true
