PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Connection String (Atlas or Local)
# If left commented or unavailable in dev, the server automatically starts embedded in-memory MongoDB
# MONGODB_URI=mongodb://127.0.0.1:27017/securepulse

# JWT Secrets
JWT_ACCESS_SECRET=securepulse_super_secret_access_token_jwt_key_2026_xyz
JWT_REFRESH_SECRET=securepulse_super_secret_refresh_token_jwt_key_2026_abc

# Email Configuration (Nodemailer)
# If not configured, OTPs and alerts are printed cleanly to the terminal console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SecurePulse Security" <security@securepulse.local>
